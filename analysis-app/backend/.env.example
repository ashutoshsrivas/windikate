PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=windikate_analysis

# JWT
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGIN=http://localhost:3000

# =====================================================================
# AWS Bedrock (Claude) — optional. When BEDROCK_ENABLED=true and creds
# are present, the intelligence layer uses Claude on Bedrock instead of
# its deterministic mock fallback.
# =====================================================================
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=1600

# Auth — leave blank on EC2 if the instance role has bedrock:InvokeModel.
# Otherwise paste an IAM user's access key (recommended for local dev).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
